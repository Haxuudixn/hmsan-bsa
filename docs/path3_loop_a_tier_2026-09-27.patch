 _DEBUG_MEM = os.environ.get("HMSAN_DEBUG_MEM") == "1"
 
+# ── Allocator policy ──
+# This file used to call torch.cuda.empty_cache() after every optimizer step.
+# That hands the whole cached block range back to the driver, so the next step
+# pays fresh cudaMalloc round-trips for everything it had just freed. Its
+# purpose was to stop the allocator growing into host memory under sysmem
+# fallback on a 12 GB card; on a card with headroom the unused pool stays small
+# by itself. Keep the behaviour, drop the per-step cost: only release when the
+# unused pool has actually grown past the threshold.
+_EMPTY_CACHE_MB = int(os.environ.get("HMSAN_EMPTY_CACHE_MB", "2048"))
+
+
+def _maybe_empty_cache(force: bool = False) -> None:
+    """Release cached blocks only when the unused pool is genuinely large."""
+    if not torch.cuda.is_available():
+        return
+    if force:
+        torch.cuda.empty_cache()
+        return
+    unused = torch.cuda.memory_reserved() - torch.cuda.memory_allocated()
+    if unused > _EMPTY_CACHE_MB * 2 ** 20:
+        torch.cuda.empty_cache()
+
 
